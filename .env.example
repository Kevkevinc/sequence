# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER put real secrets in this file.

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> "Transaction pooler" connection string.
DATABASE_URL=

# --- Auth (Clerk) ---
# Clerk dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard -> Webhooks -> your endpoint -> Signing Secret.
CLERK_WEBHOOK_SECRET=

# Where Clerk sends users to sign in / sign up, and where to send them after.
# These are in-app route paths, not secrets.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Clip storage (Cloudflare R2, S3-compatible) ---
# Cloudflare dashboard -> R2 overview (Account ID in the sidebar).
R2_ACCOUNT_ID=
# Cloudflare dashboard -> R2 -> Manage API Tokens -> Create API Token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The R2 bucket name (not a secret).
R2_BUCKET_NAME=ugc-ai-editor-clips

# --- AI editing pipeline (Google Gemini) ---
# Google AI Studio -> https://aistudio.google.com/apikey -> Create API key.
# Used to tag raw clips and plan edits. The key needs access to the Gemini
# Files API (clips are uploaded to it) and to the generateContent endpoint for
# whichever model the two pipeline steps run on. Both steps default to a Gemini
# Flash model, because Pro models return 429 quota-exceeded on the free tier
# (see the overrides below).
GEMINI_API_KEY=

# Optional: override the pipeline models (defaults shown).
# The free tier caps requests per day PER MODEL, and availability changes over
# time, so switching models is an operational move, not a code change.
# GEMINI_TAGGING_MODEL=gemini-3.6-flash
# GEMINI_DIRECTOR_MODEL=gemini-3.6-flash

# --- Operations dashboard (/status) ---
# Comma-separated email addresses allowed to open /status. Empty or unset means
# NOBODY can open it, including you — the page 404s for everyone else, so it is
# invisible rather than merely locked. Match the address you sign in to Clerk
# with; secondary addresses on the same account also work.
ADMIN_EMAILS=

# Optional: what the dashboard charges Gemini tokens at, in US dollars per
# million tokens. There is no pricing API to read these from, so they are the
# one number on the dashboard that can silently go stale — check them against
# current published pricing if the spend figure ever looks wrong. Defaults shown.
# GEMINI_INPUT_COST_PER_MTOK=0.30
# GEMINI_OUTPUT_COST_PER_MTOK=2.50

# Optional: shows Railway spend on the dashboard. Without these the Railway
# panel reads "not connected" and everything else still works.
# Railway dashboard -> Account Settings -> Tokens.
# RAILWAY_API_TOKEN=
# Railway dashboard -> your workspace -> Settings (the workspace's id).
# RAILWAY_WORKSPACE_ID=

# --- Push notifications ("your videos are ready") ---
# Renders take 10-15 minutes, so this is the only channel that reaches a creator
# after they close the app. Without these keys the app still works; it simply
# never notifies, and the button to turn notifications on does nothing.
#
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key is embedded in the browser bundle (NEXT_PUBLIC_) on purpose —
# it is not a secret. The private key must only ever live on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required by the push services so they can contact you about a misbehaving
# sender. Any address you monitor.
VAPID_CONTACT_EMAIL=mailto:you@example.com
