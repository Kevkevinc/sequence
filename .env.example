# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER put real secrets in this file.

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> "Transaction pooler" connection string.
DATABASE_URL=

# --- Auth (Clerk) ---
# Clerk dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard -> Webhooks -> your endpoint -> Signing Secret.
CLERK_WEBHOOK_SECRET=

# Where Clerk sends users to sign in / sign up, and where to send them after.
# These are in-app route paths, not secrets.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Clip storage (Cloudflare R2, S3-compatible) ---
# Cloudflare dashboard -> R2 overview (Account ID in the sidebar).
R2_ACCOUNT_ID=
# Cloudflare dashboard -> R2 -> Manage API Tokens -> Create API Token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The R2 bucket name (not a secret).
R2_BUCKET_NAME=ugc-ai-editor-clips

# --- AI editing pipeline (Google Gemini) ---
# Google AI Studio -> https://aistudio.google.com/apikey -> Create API key.
# Used to tag raw clips and plan edits. The key needs access to the
# `gemini-2.5-flash` and `gemini-2.5-pro` models.
GEMINI_API_KEY=
